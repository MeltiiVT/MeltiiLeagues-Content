[proc,macro_event_normal_dwarf_spawn] // greet player
sound_synth(dwarf_whistle, 0, 0);
npc_anim(dwarf_drunkwave, 20);
npc_say("'Ello der <displayname>!'");
%npc_macro_event_target = uid;
npc_setmode(playerfollow);

[ai_timer,macro_event_normal_dwarf]
if (%npc_int = ^normal_dwarf_angry) {
    if (~macro_event_lost_hostile = true) {
        npc_queue(5, 0, 0); // despawn
    }
    return;
}
if (~macro_event_lost = true) {
    npc_queue(5, 0, 0);
    return;
}
if (finduid(%npc_macro_event_target) = true) {
    if (%npc_int = 0) {
        npc_anim(dwarf_drunkwave, 20);
        sound_synth(dwarf_whistle, 0, 0);
        npc_say("Oi, over here <displayname>!");
    } else if (%npc_int = 1) {
        npc_anim(dwarf_drunkwave, 20);
        sound_synth(dwarf_whistle, 0, 0);
        npc_say("Are you there? <displayname>!");
    } else if (%npc_int = 2) {
        sound_synth(dwarf_whistle, 0, 0);
        npc_say("I've got places to be, <displayname>!");
    } else if (%npc_int = 3) {
        npc_anim(dwarf_drunkwave, 20);
        sound_synth(dwarf_whistle, 0, 0);
        npc_say("You're the worst <displayname>!");
    } else if (%npc_int = 4) { // fail
        %npc_int = ^normal_dwarf_angry;
        %macro_event = ^no_macro_event;
        inv_add(inv, burnt_cake, 10);
        npc_delay(0);
        npc_del;
        return;
    }
    %npc_int = add(%npc_int, 1);
}

[ai_queue5,macro_event_normal_dwarf] // despawn
npc_say("That's not very cool.");
npc_delay(2); // osrs
npc_del;

[ai_queue6,macro_event_normal_dwarf] // say good bye
npc_del;

[opnpc1,macro_event_normal_dwarf]
if (uid ! %npc_macro_event_target) {
    ~chatnpc("<p,neutral>Could you get their attention for me?"); // osrs
    return;
}
if (%npc_int = ^normal_dwarf_happy) {
    ~chatnpc("<p,happy>'Ave a nice day."); // osrs
    return;
}
inv_add(inv, cert_coal, 10);
inv_add(inv, macro_genilamp, 1);

%npc_int = ^normal_dwarf_happy;
%macro_event = ^no_macro_event;

npc_queue(6, 0, 0); // say good bye
npc_settimer(0);
~chatnpc("<p,happy>Glad you talked to me, take this lamp I found."); // 2004
