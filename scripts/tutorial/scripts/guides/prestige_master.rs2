[opnpc1,prestige_master]

~chatnpc("<p,neutral>Hello adventurer, I can assist with all things to do with prestige.");
~chatnpc("<p,quiz>What can I help you with today?");
@prestigemaster_dialogue;


[label,prestigemaster_dialogue]
def_int $prestigeMenu = ~p_choice4("Prestige Information", 1, "Prestige Skills", 2, "Purchase Perks", 3, "Nothing", 4);

    if ($prestigeMenu = 1) {
        ~chatnpc("<p,neutral>Prestiging skills gives you permanent buffs to your skills.");
        ~chatnpc("<p,neutral>You can prestige a skill after you achieve level 99 in that skill.");
        ~chatnpc("<p,neutral>You can talk to me and select the Prestige Skills option, and I can prestige them for you.");
        ~chatnpc("<p,neutral>Do be warned, when you prestige a skill your exp in that skill will be reset to 0.");
        ~chatnpc("<p,neutral>You'll receive one prestige point in that skill, which can be spent by talking to me for a permanent buff.");
        ~chatnpc("<p,neutral>You'll also receive an additional 1x onto your skill multiplier in that skill.");
        ~chatnpc("<p,neutral>Is there anything else I can help you with today?");
        @prestigemaster_dialogue;
    } else if ($prestigeMenu = 2) {
            @prestigemaster_prestigeskillsmenu;
    } else if ($prestigeMenu = 3) {
            @prestigemaster_skillsmenu;
    } else if ($prestigeMenu = 3) {
            ~chatplayer("<p,neutral>I don't need anything right now.");
        }

[label,prestigemaster_prestigeskillsmenu]
def_int $prestigeSkillsMenu = ~p_choice5("Combat Skills", 1, "Processing Skills", 2, "Gathering Skills", 3, "Misc Skills", 4, "Nevermind", 5);

if ($prestigeSkillsMenu = 1) {
        @prestigemaster_prestigecombatskillsmenu;
    } else if ($prestigeSkillsMenu = 2) {
        @prestigemaster_prestigeprocessingskillsmenu;
    } else if ($prestigeSkillsMenu = 3) {
        @prestigemaster_prestigegatheringskillsmenu;
    } else if ($prestigeSkillsMenu = 4) {
        @prestigemaster_prestigemiscskillsmenu;
    } else if ($prestigeSkillsMenu = 5) {
        ~chatplayer("<p,neutral>I don't need anything right now.");
}

[label,prestigemaster_prestigecombatskillsmenu]
def_int $prestigeCombatSkillsMenu = ~p_choice5("Attack", 1, "Strength", 2, "Defence", 3, "Ranged", 4, "More Options", 5);

if ($prestigeCombatSkillsMenu = 1) {
        if (stat(attack) = 99) {
            def_int $prestigeConfirm = ~p_choice2("Yes - Prestige Skill", 1, "No - Do Not Prestige", 2);
                if ($prestigeConfirm = 1) {
                    %prestigepoint_attack = add(%prestigepoint_attack,1);
                    %prestigetotal_attack = add(%prestigetotal_attack,1);
                    def_int $prestigepoints =  %prestigepoint_attack;
                    def_int $prestigetimes = %prestigetotal_attack;
                    mes("Congratulations, you've prestiged your Attack skill!");
                    mes("You've prestiged your Attack Skill <tostring($prestigetimes)> times and have <tostring($prestigepoints)> Attack Prestige Points.");
                    stat_set_min(attack);
                } else {
                    ~chatplayer("<p,neutral>I've changed my mind.");
                    }
        } else {
            ~chatnpc("<p,neutral>You need to be level 99 to prestige.");
        }
        
} else if ($prestigeCombatSkillsMenu = 2) {
        if (stat(strength) = 99) {
            def_int $prestigeConfirm = ~p_choice2("Yes - Prestige Skill", 1, "No - Do Not Prestige", 2);
                if ($prestigeConfirm = 1) {
                    %prestigepoint_strength = add(%prestigepoint_strength,1);
                    %prestigetotal_strength = add(%prestigetotal_strength,1);
                    def_int $prestigepoints =  %prestigepoint_strength;
                    def_int $prestigetimes = %prestigetotal_strength;
                    mes("Congratulations, you've prestiged your Strength skill!");
                    mes("You've prestiged your Strength Skill <tostring($prestigetimes)> times and have <tostring($prestigepoints)> Strength Prestige Points.");
                    stat_set_min(strength);
                } else {
                    ~chatplayer("<p,neutral>I've changed my mind.");
                }
            
        } else {
            ~chatnpc("<p,neutral>You need to be level 99 to prestige.");
        }
} else if ($prestigeCombatSkillsMenu = 3) {
        if (stat(defence) = 99) {
            def_int $prestigeConfirm = ~p_choice2("Yes - Prestige Skill", 1, "No - Do Not Prestige", 2);
                if ($prestigeConfirm = 1) {
