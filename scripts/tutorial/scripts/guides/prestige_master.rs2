[label,prestigemaster_magicmenu]
def_int $prestigeMagicMenu = ~p_choice3("Increased Magic Damage", 1, "Superheat Hides", 2, "Go Back", 3);

if ($prestigeMagicMenu = 1) {
        ~chatnpc("<p,neutral>This perk is not yet available, sorry.");
    } else if ($prestigeMagicMenu = 2) {
          ~chatnpc("<p,neutral>This will allow you to tan hides with the Superheat spell. Are you sure you wish to use your Magic prestige point?");
        def_int $prestigeMagicDoubleLoot = ~p_choice2("Yes - Upgrade Skill", 1, "No - Go Back", 2);
        if ($prestigeMagicDoubleLoot = 1 & %prestigemagic_3 = 0) {
            if (%prestigepoint_magic > 0) {
            %prestigepoint_magic = sub(%prestigepoint_magic,1);
            %prestigemagic_3 = 1;
            ~chatnpc("<p,neutral>Perk unlocked! You can now tan hides with the Superheat spell.");
            } else {
                ~chatnpc("<p,neutral>You do not have enough Magic prestige points.");
            }
        } else if ($prestigeMagicDoubleLoot = 1) {
            ~chatnpc("<p,neutral>You already have this perk.");
        } else if ($prestigeMagicDoubleLoot = 2) {
            @prestigemaster_thievingmenu;
        }
    } else if ($prestigeMagicMenu = 3) {
        @prestigemaster_skillsmenu;
}

[label,prestigemaster_thievingmenu]
def_int $prestigeThievingMenu = ~p_choice3("Higher Success Chance", 1, "Double Thieving Loot", 2, "Go Back", 3);

if ($prestigeThievingMenu = 1) {
        ~chatnpc("<p,neutral>This perk is not yet available, sorry.");
    } else if ($prestigeThievingMenu = 2) {
         ~chatnpc("<p,neutral>This will double the loot received from thieving. Are you sure you wish to use your thieving prestige point?");
        def_int $prestigeThievingDoubleLoot = ~p_choice2("Yes - Upgrade Skill", 1, "No - Go Back", 2);
        if ($prestigeThievingDoubleLoot = 1 & %prestigethieving_2 = 0) {
            if (%prestigepoint_thieving > 0) {
            %prestigepoint_thieving = sub(%prestigepoint_thieving,1);
            %prestigethieving_2 = 1;
            ~chatnpc("<p,neutral>Perk unlocked! Your thieving success chance has been increased.");
            } else {
                ~chatnpc("<p,neutral>You do not have enough thieving prestige points.");
            }
        } else if ($prestigeThievingDoubleLoot = 1) {
            ~chatnpc("<p,neutral>You already have this perk.");
        } else if ($prestigeThievingDoubleLoot = 2) {
            @prestigemaster_thievingmenu;
        }
    } else if ($prestigeThievingMenu = 3) {
        @prestigemaster_skillsmenu;
}
