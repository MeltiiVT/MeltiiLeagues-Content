                    mes("Congratulations, you've prestiged your Ranged skill!");
                    mes("You've prestiged your Ranged Skill <tostring($prestigetimes)> times and have <tostring($prestigepoints)> Ranged Prestige Points.");
                    stat_set_min(ranged);
                } else {
                    ~chatplayer("<p,neutral>I've changed my mind.");
                }
            
        } else {
            ~chatnpc("<p,neutral>You need to be level 99 to prestige.");
        }
    } else if ($prestigeCombatSkillsMenu = 5) {
    @prestigemaster_prestigecombatskillsmenu2;
}

