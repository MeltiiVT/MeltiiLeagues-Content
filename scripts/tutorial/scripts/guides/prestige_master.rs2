                    mes("You've prestiged your Defence Skill <tostring($prestigetimes)> times and have <tostring($prestigepoints)> Defence Prestige Points.");
                    stat_set_min(defence);
                } else {
                    ~chatplayer("<p,neutral>I've changed my mind.");
                }
            
        } else {
            ~chatnpc("<p,neutral>You need to be level 99 to prestige.");
        }
} else if ($prestigeCombatSkillsMenu = 4) {
        if (stat(ranged) = 99) {
            def_int $prestigeConfirm = ~p_choice2("Yes - Prestige Skill", 1, "No - Do Not Prestige", 2);
                if ($prestigeConfirm = 1) {
                    %prestigepoint_ranged = add(%prestigepoint_ranged,1);
                    %prestigetotal_ranged = add(%prestigetotal_ranged,1);
                    def_int $prestigepoints =  %prestigepoint_ranged;
